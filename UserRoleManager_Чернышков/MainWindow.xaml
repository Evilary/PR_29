<Window x:Class="UserRoleManager_Чернышков.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UserRoleManager_Чернышков"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Background="#F2F2F2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Content="Пользователи" Width="120" Margin="0,0,8,0" Command="{Binding OnOpenUsers}"/>
                <Button Content="Роли" Width="100" Margin="0,0,8,0" Command="{Binding OnOpenRoles}"/>
                <Button Content="Статистика" Width="120" Command="{Binding OnOpenStats}"/>
            </StackPanel>
        </Grid>

        <Frame x:Name="frame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
